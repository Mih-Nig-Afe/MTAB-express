{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "rewrites": [
    { "source": "/mini-app", "destination": "/mini-app" },
    { "source": "/track/:code", "destination": "/track/:code" }
  ]
}
