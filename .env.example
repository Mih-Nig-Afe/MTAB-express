# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=mela
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=mela_express
# Prisma seed (host → dev Postgres on 5433; use postgresql:// not asyncpg)
PRISMA_DATABASE_URL=postgresql://mela:mela@localhost:5433/mela_express

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # From BotFather

# ─── Chapa ───────────────────────────────────────────────────────────────────
CHAPA_SECRET_KEY=             # From Chapa merchant dashboard
CHAPA_WEBHOOK_SECRET=         # Set in Chapa dashboard → webhook config
CHAPA_BASE_URL=https://api.chapa.co/v1

# ─── Branding (single source — change here to rebrand the entire platform) ───
# Backend (Railway / Docker api service)
BRAND_NAME=MTAB Express
BRAND_SHORT=MTAB
TRACKING_PREFIX=MTAB
SMS_SENDER_ID=MTABExpress

# Frontends (Vercel) — mirror backend values OR omit to fetch from API /public/brand
NEXT_PUBLIC_BRAND_NAME=MTAB Express
NEXT_PUBLIC_BRAND_SHORT=MTAB
NEXT_PUBLIC_TRACKING_PREFIX=MTAB

# ─── App ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://api.yourdomain.com   # Public HTTPS URL of the API
PUBLIC_PORTAL_URL=https://track.yourdomain.com  # Customer tracking portal (QR on stickers)
ENVIRONMENT=production                     # development | staging | production

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Object Storage (Cloudflare R2 / DigitalOcean Spaces) ────────────────────
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=mela-express-assets
S3_PUBLIC_BASE_URL=https://assets.yourdomain.com    # CDN URL for public files

# ─── SMS Gateway ─────────────────────────────────────────────────────────────
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=MTABExpress

# ─── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=                   # From Sentry project settings

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
